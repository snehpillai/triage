# Anthropic — required
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — optional, only used as fallback if Anthropic API is down
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# LangSmith — recommended, enables full trace visibility
# Sign up at https://smith.langchain.com, then Settings > API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=triage

# Postgres (pgvector) — local dev points at Docker container on 5433
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5433/triage

# Redis — local dev points at Docker container
REDIS_URL=redis://localhost:6379

# Voyage AI — required for embeddings
# Sign up at https://dash.voyageai.com, then API Keys
VOYAGE_API_KEY=pa-...
